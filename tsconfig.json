{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    
    
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
   
    "**/*"                                       /* Alternative: Includes everything from the project root downwards */
  ],
  "exclude": [
    "node_modules",                              /* Always exclude node_modules to keep compilation fast */
    "**/*.spec.ts"                               /* Optional: Exclude test files if you don't want them compiled */
  ]
}